# COPIAR A /etc/laboratorios/laboratorios.env, permisos 0640 root:laboratorios.
# Completar todos los REEMPLAZAR. No usar export ni espacios alrededor de =.
DJANGO_ENV=production
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_EXCLUSIVA_DE_PRODUCCION
DJANGO_ALLOWED_HOSTS=lab.ejemplo.edu.co
DJANGO_HTTPS=1
DATABASE_URL=mysql://laboratorios_app:REEMPLAZAR@127.0.0.1:3306/laboratorios
DB_COLLATION=utf8mb4_unicode_ci
UTS_SITIO_URL=https://lab.ejemplo.edu.co
UTS_PASSWORD_RESET_ENABLED=0
UTS_CLAVE_TEMPORAL_HORAS=24
UTS_NOTIFICACIONES_SEGUNDO_PLANO=1
UTS_NOTIFICAR_CORREOS=REEMPLAZAR_DESTINATARIO
UTS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
UTS_EMAIL_HOST=REEMPLAZAR_SERVIDOR_SMTP
UTS_EMAIL_PORT=587
UTS_EMAIL_TLS=1
UTS_EMAIL_SSL=0
UTS_EMAIL_USER=REEMPLAZAR_REMITENTE
UTS_EMAIL_PASSWORD=REEMPLAZAR_CREDENCIAL_AUTORIZADA
UTS_EMAIL_FROM="Laboratorios UTS <REEMPLAZAR_REMITENTE>"
