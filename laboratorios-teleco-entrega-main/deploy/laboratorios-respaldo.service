[Unit]
Description=Respaldo privado de Laboratorios UTS
After=network.target

[Service]
Type=oneshot
User=root
Environment=MYSQL_CNF=/etc/laboratorios/backup.cnf
Environment=DESTINO=/var/backups/laboratorios
Environment=BASE=laboratorios
ExecStart=/bin/bash /srv/laboratorios/deploy/respaldo_mysql.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/laboratorios
