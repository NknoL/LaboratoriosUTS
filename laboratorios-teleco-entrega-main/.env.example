# Plantilla local. No reemplazar un .env existente ni guardar claves reales aqui.
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=mysql://laboratorios_app:REEMPLAZAR@127.0.0.1:3306/laboratorios
DB_COLLATION=utf8mb4_unicode_ci
UTS_SITIO_URL=http://127.0.0.1:8000
UTS_PASSWORD_RESET_ENABLED=0
UTS_CLAVE_TEMPORAL_HORAS=24
UTS_NOTIFICACIONES_SEGUNDO_PLANO=1

# Pruebas locales: escribe correos en correos_locales/, no envia a Internet.
UTS_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
UTS_NOTIFICAR_CORREOS=
UTS_EMAIL_FROM=Laboratorios UTS <laboratorios@example.invalid>

# Produccion: completar deploy/laboratorios.env.example fuera del repositorio.
